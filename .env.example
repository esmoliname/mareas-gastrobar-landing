# ============================================
# Mareas Gastrobar — variables de entorno
# Copiá este archivo a .env y ajustá los valores.
# Solo las variables con prefijo VITE_ son visibles en el bundle del cliente.
# ============================================

# Número de WhatsApp para pedidos y reservas (solo dígitos, con código de país)
VITE_WHATSAPP_NUMBER=50689779500

# Teléfono de contacto (formato de display y formato tel:)
VITE_PHONE_DISPLAY=+506 2460-9500
VITE_PHONE_TEL=+50624609500

# Correo de contacto
VITE_CONTACT_EMAIL=empleos@mareascr.com

# URL pública de producción (SEO / canónicos / QR)
VITE_SITE_URL=https://restaurantemareascr.com

# Credenciales del panel admin (NO usar en producción real sin backend)
VITE_ADMIN_USER=admin
VITE_ADMIN_PASS=mareas2024